/*
 * Eris — combos and mode macros.
 *
 * Key positions were re-indexed for the 62-key split transform.
 * The combo keys are the same PHYSICAL keys as before (all on the left half):
 *
 *   old single-half index -> new split index
 *   ESC     (R1C1):  0  ->  0
 *   BSPC    (R1C2):  1  ->  1
 *   LSHIFT  (R4C1): 12  -> 24
 *   LCTRL   (R5C1): 16  -> 32
 *
 * NOTE: a ZMK combo can only trigger ONE behavior. The old file listed three
 * bindings per mode combo, but only the first one actually ran. The intended
 * three-step sequences are now wrapped in macros so all steps really execute.
 */

#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    macros {
        /*
         * USB mode:
         *  1. select the intentionally empty BT profile (1)
         *  2. switch output to USB
         *  3. go to layer 4 (USB-mode layer)
         */
        usb_mode: usb_mode {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&out OUT_USB>, <&to 4>;
        };

        /*
         * Bluetooth mode:
         *  1. select the paired BT profile (0)
         *  2. switch output to BLE
         *  3. go to layer 1 (kept for compatibility with the old workflow;
         *     layer 1 is transparent on the left half, so typing there is
         *     unaffected)
         */
        bt_mode: bt_mode {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&out OUT_BLE>, <&to 1>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /* ESC (0) + LSHIFT (24): clear the current Bluetooth profile */
        shift_esc_pair {
            timeout-ms = <50>;
            key-positions = <0 24>;
            bindings = <&bt BT_CLR>;
        };

        /* ESC (0) + LCTRL (32): force USB mode */
        force_usb_mode {
            timeout-ms = <50>;
            key-positions = <0 32>;
            bindings = <&usb_mode>;
        };

        /* BSPC (1) + LCTRL (32): force Bluetooth mode */
        force_bt_mode {
            timeout-ms = <50>;
            key-positions = <1 32>;
            bindings = <&bt_mode>;
        };
    };
};
