/*
 * Eris — combos and mode macros.
 *
 * Key positions were re-indexed for the 62-key split transform.
 *
 * NOTE: A ZMK combo can only trigger ONE behavior. Multi-step sequences
 * are wrapped in macros so all steps execute.
 */

#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    macros {
        /*
         * USB mode:
         * 1. Select the intentionally empty BT profile (1)
         * 2. Switch output to USB
         * 3. Go to layer 4
         */
        usb_mode: usb_mode {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&out OUT_USB>, <&to 4>;
        };

        /*
         * Bluetooth mode:
         * 1. Select paired BT profile (0)
         * 2. Switch output to BLE
         * 3. Go to layer 1
         */
        bt_mode: bt_mode {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&out OUT_BLE>, <&to 1>;
        };

        /*
         * Windows virtual desktop RIGHT:
         * Win + Ctrl + Right
         */
        desktop_right: desktop_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_press &kp LCTRL>
                , <&macro_tap &kp RIGHT>
                , <&macro_release &kp LCTRL>
                , <&macro_release &kp LGUI>;
        };

        /*
         * Windows virtual desktop LEFT:
         * Win + Ctrl + Left
         */
        desktop_left: desktop_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_press &kp LCTRL>
                , <&macro_tap &kp LEFT>
                , <&macro_release &kp LCTRL>
                , <&macro_release &kp LGUI>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /* Clear current Bluetooth profile */
        shift_esc_pair {
            timeout-ms = <50>;
            key-positions = <4 32>;
            bindings = <&bt BT_CLR>;
        };

        /* Force USB mode */
        force_usb_mode {
            timeout-ms = <50>;
            key-positions = <1 32>;
            bindings = <&usb_mode>;
        };

        /* Force Bluetooth mode */
        force_bt_mode {
            timeout-ms = <50>;
            key-positions = <0 32>;
            bindings = <&bt_mode>;
        };

        /* COMBO 48 + 59: Switch Desktop Right (Layer 0 only) */
        swap_desktop_right {
            timeout-ms = <50>;
            key-positions = <43 59>;
            layers = <0>;
            bindings = <&desktop_right>;
        };

        /* COMBO 48 + 40: Switch Desktop Left (Layer 0 only) */
        swap_desktop_left {
            timeout-ms = <50>;
            key-positions = <43 40>;
            layers = <0>;
            bindings = <&desktop_left>;
        };
    };
};